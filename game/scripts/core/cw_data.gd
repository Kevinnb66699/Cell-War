enum Faction { IMMUNE, CANCER }                 # 免疫方 / 癌症方
enum ImmuneType { BASIC, B_CELL, T_CELL, MACRO, DENDRITIC }
enum CancerType { MELANOMA, SIGNET, OSTEO, SCLC }  # 黑色素瘤 / 印戒 / 骨肉瘤 / 小细胞肺癌

